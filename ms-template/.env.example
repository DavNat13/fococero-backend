# ==========================================
# 🔧 Variables de Entorno de Ejemplo
# ==========================================
# Copia este archivo a .env y personaliza

# Puerto del servicio (cambiar para cada MS)
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=fococero_admin
DB_PASSWORD=fococero_pass
DB_NAME=fococero_ms_template
DB_MAX=20

# Redis (opcional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Eureka Service Discovery
EUREKA_HOST=localhost
EUREKA_PORT=8761

# RabbitMQ (opcional)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Node environment
NODE_ENV=development