{
    "name": "fococero-ms-emergencias",
    "version": "1.0.0",
    "description": "Microservicio de Integración con Organismos de Emergencia (Bomberos, CONAF, Carabineros)",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "rimraf dist && tsc",
        "start": "node dist/index.js",
        "test": "jest --passWithNoTests",
        "lint": "eslint src/**/*.ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "fococero",
        "microservice",
        "emergencias",
        "webhooks"
    ],
    "author": "FocoCero Team",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.15.0",
        "axios-retry": "^4.5.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.1",
        "env-var": "^7.5.0",
        "express": "^5.2.1",
        "helmet": "^8.1.0",
        "pg": "^8.20.0",
        "uuid": "^13.0.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.14",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "eslint": "^10.2.0",
        "globals": "^17.5.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "rimraf": "^6.1.3",
        "supertest": "^6.3.4",
        "ts-jest": "^29.4.9",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1"
    }
